# Product stack (`docker-compose.yml`). Copy to `.env` and set every required value.
# Verify: docker compose -f docker-compose.yml --env-file .env.example config
# (after filling placeholders, or use scripts/ci/check-compose-config.sh).

# Image registry and versions (from Phase 3)
CBT_IMAGE_REPO=ghcr.io
IMAGE_VERSION=1
NEXT_IMAGE_NAME_DOCKERHUB=mminichino/couchbase-traces
NEXT_OTEL_COLLECTOR_IMAGE_NAME_DOCKERHUB=mminichino/couchbase-traces-otel-collector

# Couchbase Server Enterprise image (pinned in docs/port-notes.md)
COUCHBASE_IMAGE=couchbase/server:enterprise-8.0.3

# Ingest image name without registry prefix
CBT_INGEST_IMAGE_NAME=mminichino/couchbase-traces-ingest

# Couchbase cluster (required for product compose)
CBT_COUCHBASE_ADMIN_USER=Administrator
CBT_COUCHBASE_ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
CBT_COUCHBASE_QUERY_USER=cbt_query
CBT_COUCHBASE_QUERY_PASSWORD=CHANGE_ME_QUERY_PASSWORD
CBT_COUCHBASE_INGEST_USER=cbt_ingest
CBT_COUCHBASE_INGEST_PASSWORD=CHANGE_ME_INGEST_PASSWORD
# Optional monitoring user (cluster Infrastructure / Status tabs)
CBT_COUCHBASE_MONITOR_USER=cbt_monitor
CBT_COUCHBASE_MONITOR_PASSWORD=CHANGE_ME_MONITOR_PASSWORD

CBT_COUCHBASE_BUCKET=otel
CBT_COUCHBASE_SCOPE=default
CBT_COUCHBASE_RAM_MB=2048
# App metadata bucket (cbt_meta, carved from CBT_COUCHBASE_RAM_MB). Required:
# teams, users, invites, and sessions live there. The API exits at startup
# naming the missing variable.
CBT_METADATA_USER=cbt_meta
CBT_METADATA_PASSWORD=CHANGE_ME_METADATA_PASSWORD
# CBT_METADATA_RAM_MB=256
# Default timeout (ms) for every metadata SQL++ read; bounds slow reads.
# CBT_METADATA_QUERY_TIMEOUT_MS=10000

# Ingest bearer token (≥ 32 characters)
CBT_INGEST_TOKEN=CHANGE_ME_INGEST_TOKEN_32_CHARS_MINIMUM

# API / UI ports and ingestion key
CBT_API_PORT=8000
CBT_APP_PORT=8080
CBT_APP_URL=http://localhost
CBT_OPAMP_PORT=4320
CBT_API_KEY=CHANGE_ME_COLLECTOR_API_KEY
CBT_LOG_LEVEL=info

# Session and encryption (recommended for production)
# EXPRESS_SESSION_SECRET=CHANGE_ME_64_HEX_OR_BASE64
# TOKEN_ENCRYPTION_KEY=

# OTLP / telemetry TTL in ingest (Phase 5 defaults)
CBT_LOGS_TTL=720h
CBT_TRACES_TTL=720h
CBT_METRICS_TTL=720h
CBT_SESSIONS_TTL=720h

# Capella / external Couchbase (use with docker-compose.capella.yml)
# CBT_COUCHBASE_CONNSTR=couchbases://cb.example.cloud.couchbase.com
# CBT_COUCHBASE_WAN_PROFILE=true
# CBT_COUCHBASE_CA_CERT_PATH=/path/in/container/ca.pem
