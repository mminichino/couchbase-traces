# Used by docker-compose.yml
CBT_IMAGE_REPO=docker.hyperdx.io
CH_IMAGE_REPO=docker.clickhouse.com
IMAGE_NAME_DOCKERHUB=hyperdx/hyperdx
NEXT_IMAGE_NAME_DOCKERHUB=clickhouse/clickstack
NEXT_LOCAL_IMAGE_NAME_DOCKERHUB=clickhouse/clickstack-local
LOCAL_IMAGE_NAME_DOCKERHUB=hyperdx/hyperdx-local
NEXT_ALL_IN_ONE_IMAGE_NAME_DOCKERHUB=clickhouse/clickstack-all-in-one
ALL_IN_ONE_IMAGE_NAME_DOCKERHUB=hyperdx/hyperdx-all-in-one
NEXT_OTEL_COLLECTOR_IMAGE_NAME_DOCKERHUB=clickhouse/clickstack-otel-collector
OTEL_COLLECTOR_IMAGE_NAME_DOCKERHUB=hyperdx/hyperdx-otel-collector
CODE_VERSION=2.44.0
IMAGE_VERSION_SUB_TAG=.44.0
IMAGE_VERSION=2
IMAGE_NIGHTLY_TAG=2-nightly
IMAGE_LATEST_TAG=latest

# ---------------------------------------------------------------------------
# Dev environment ports
# ---------------------------------------------------------------------------
# When using worktree isolation (source scripts/dev-env.sh), these are
# overridden with slot-derived values.  The defaults below match the original
# hardcoded ports so that existing workflows (yarn dev without the isolation
# helper) still work.
CBT_API_PORT=${CBT_API_PORT:-8000}
CBT_APP_PORT=${CBT_APP_PORT:-8080}
CBT_APP_URL=http://localhost
CBT_LOG_LEVEL=debug
CBT_OPAMP_PORT=${CBT_OPAMP_PORT:-4320}
CBT_BASE_PATH=
# Comma-separated hostnames or exact IP literals that may receive webhooks.
# Domain entries also permit their subdomains; IP entries are exact matches.
WEBHOOK_HOSTNAME_ALLOWLIST=
# 32-byte key (base64 or hex) that encrypts stored Slack and OAuth tokens.
# Generate with `openssl rand -base64 32`. Unset means plain text.
TOKEN_ENCRYPTION_KEY=

# Generate once with openssl rand -hex 32; reuse across restarts and replicas.
# Configure in .env.local with docker compose --env-file .env --env-file .env.local up -d.
# EXPRESS_SESSION_SECRET=

# Docker service ports (overridden by scripts/dev-env.sh for isolation)
CBT_DEV_MONGO_PORT=27017
CBT_DEV_CH_HTTP_PORT=8123
CBT_DEV_CH_NATIVE_PORT=9000
CBT_DEV_OTEL_HEALTH_PORT=13133
CBT_DEV_OTEL_GRPC_PORT=4317
CBT_DEV_OTEL_HTTP_PORT=4318
CBT_DEV_OTEL_METRICS_PORT=8888
CBT_DEV_OTEL_JSON_HTTP_PORT=14318

# Otel Collector version (used as Docker build arg for image tags and component versions)
# When bumping, look up the core version from the upstream manifest:
# https://github.com/open-telemetry/opentelemetry-collector-releases/blob/main/distributions/otelcol-contrib/manifest.yaml
OTEL_COLLECTOR_VERSION=0.155.0
OTEL_COLLECTOR_CORE_VERSION=1.61.0

# Otel/Clickhouse config
CBT_OTEL_EXPORTER_CLICKHOUSE_DATABASE=default
