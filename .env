# Used by docker-compose.yml and docker-compose.dev.yml (development defaults below).

# Image registry and versions
CBT_IMAGE_REPO=ghcr.io
CH_IMAGE_REPO=ghcr.io
IMAGE_NAME_DOCKERHUB=mminichino/couchbase-traces
NEXT_IMAGE_NAME_DOCKERHUB=mminichino/couchbase-traces
NEXT_LOCAL_IMAGE_NAME_DOCKERHUB=mminichino/couchbase-traces-local
LOCAL_IMAGE_NAME_DOCKERHUB=mminichino/couchbase-traces-local
NEXT_ALL_IN_ONE_IMAGE_NAME_DOCKERHUB=mminichino/couchbase-traces-all-in-one
ALL_IN_ONE_IMAGE_NAME_DOCKERHUB=mminichino/couchbase-traces-all-in-one
NEXT_OTEL_COLLECTOR_IMAGE_NAME_DOCKERHUB=mminichino/couchbase-traces-otel-collector
OTEL_COLLECTOR_IMAGE_NAME_DOCKERHUB=mminichino/couchbase-traces-otel-collector
CODE_VERSION=2.44.0
IMAGE_VERSION_SUB_TAG=.44.0
IMAGE_VERSION=2
IMAGE_NIGHTLY_TAG=2-nightly
IMAGE_LATEST_TAG=latest

# Couchbase Server Enterprise (development only)
COUCHBASE_IMAGE=couchbase/server:enterprise-8.0.3
CBT_INGEST_IMAGE_NAME=mminichino/couchbase-traces-ingest

# Couchbase credentials (development only)
CBT_COUCHBASE_ADMIN_USER=Administrator
CBT_COUCHBASE_ADMIN_PASSWORD=dev-admin-password
CBT_COUCHBASE_QUERY_USER=cbt_query
CBT_COUCHBASE_QUERY_PASSWORD=dev-query-password
CBT_COUCHBASE_INGEST_USER=cbt_ingest
CBT_COUCHBASE_INGEST_PASSWORD=dev-ingest-password
CBT_COUCHBASE_MONITOR_USER=cbt_monitor
CBT_COUCHBASE_MONITOR_PASSWORD=dev-monitor-password
CBT_COUCHBASE_BUCKET=otel
CBT_COUCHBASE_SCOPE=default
# App metadata bucket user (required; development only)
CBT_METADATA_USER=cbt_meta
CBT_METADATA_PASSWORD=dev-metadata-password
CBT_COUCHBASE_RAM_MB=2048
CBT_COUCHBASE_INDEX_RAM_MB=512
CBT_COUCHBASE_SEARCH_RAM_MB=512

# Ingest bearer token (development only, ≥ 32 characters)
CBT_INGEST_TOKEN=dev-ingest-token-0000000000000000000000

# ---------------------------------------------------------------------------
# Dev environment ports
# ---------------------------------------------------------------------------
CBT_API_PORT=8000
CBT_APP_PORT=8080
CBT_APP_URL=http://localhost
CBT_LOG_LEVEL=debug
CBT_OPAMP_PORT=4320
CBT_BASE_PATH=
WEBHOOK_HOSTNAME_ALLOWLIST=
TOKEN_ENCRYPTION_KEY=

# Collector ingestion API key (development only)
CBT_API_KEY=super-secure-ingestion-api-key

# Docker service ports (overridden by scripts/dev-env.sh for isolation)
CBT_DEV_MONGO_PORT=27017
CBT_DEV_CB_MGMT_PORT=8091
CBT_DEV_CB_PORT_8092=8092
CBT_DEV_CB_PORT_8093=8093
CBT_DEV_CB_PORT_8094=8094
CBT_DEV_CB_PORT_8095=8095
CBT_DEV_CB_PORT_8096=8096
CBT_DEV_CB_PORT_8097=8097
CBT_DEV_CB_KV_PORT=11210
CBT_DEV_INGEST_PORT=4320
CBT_DEV_OTEL_HEALTH_PORT=13133
CBT_DEV_OTEL_GRPC_PORT=4317
CBT_DEV_OTEL_HTTP_PORT=4318
CBT_DEV_OTEL_METRICS_PORT=8888

# Otel Collector version (Docker build args)
OTEL_COLLECTOR_VERSION=0.155.0
OTEL_COLLECTOR_CORE_VERSION=1.61.0

# OTLP retention in ingest (development only)
CBT_LOGS_TTL=720h
CBT_TRACES_TTL=720h
CBT_METRICS_TTL=720h
CBT_SESSIONS_TTL=720h

# Legacy CI integration (development only)
