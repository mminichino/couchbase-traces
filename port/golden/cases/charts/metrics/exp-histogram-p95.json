{
  "id": "metrics-exp-histogram-p95",
  "description": "exponential histogram quantile p95 (ungrouped)",
  "source": "metrics_exponential_histogram",
  "config": {
    "select": [
      {
        "aggFn": "quantile",
        "level": 0.95,
        "valueExpression": "Value",
        "metricType": "exponential histogram",
        "metricName": "parity.exponential",
        "alias": "value"
      }
    ],
    "metricTables": {
      "gauge": "otel_metrics_gauge",
      "sum": "otel_metrics_sum",
      "histogram": "otel_metrics_histogram",
      "summary": "otel_metrics_summary",
      "exponential histogram": "otel_metrics_exponential_histogram"
    },
    "dateRange": {
      "fromMinutesAgo": 60,
      "toMinutesAgo": 0
    }
  },
  "compare": {
    "ignoreColumns": [
      "__cbt_id"
    ]
  },
  "features": [
    "app-chart",
    "app-services"
  ]
}
