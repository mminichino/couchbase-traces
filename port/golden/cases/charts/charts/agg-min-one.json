{
  "id": "charts-agg-min-one",
  "description": "min with one group",
  "source": "logs",
  "config": {
    "select": [
      {
        "aggFn": "min",
        "valueExpression": "SeverityNumber",
        "aggCondition": "",
        "aggConditionLanguage": "sql",
        "alias": "value"
      }
    ],
    "granularity": "5 minute",
    "dateRange": {
      "fromMinutesAgo": 60,
      "toMinutesAgo": 0
    },
    "groupBy": "ServiceName"
  },
  "compare": {
    "ignoreColumns": [
      "__cbt_id"
    ]
  },
  "features": [
    "app-search",
    "app-chart"
  ]
}
