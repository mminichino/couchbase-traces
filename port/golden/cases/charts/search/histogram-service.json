{
  "id": "search-histogram-service",
  "description": "Histogram by service",
  "source": "logs",
  "config": {
    "select": [
      {
        "aggFn": "count",
        "valueExpression": ""
      }
    ],
    "groupBy": "ServiceName",
    "granularity": "5 minute",
    "where": "SeverityText:INFO",
    "whereLanguage": "lucene",
    "dateRange": {
      "fromMinutesAgo": 120,
      "toMinutesAgo": 0
    }
  },
  "features": [
    "app-search",
    "app-chart"
  ]
}
