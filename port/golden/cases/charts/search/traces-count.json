{
  "id": "search-trace-count",
  "description": "Trace search count",
  "source": "traces",
  "config": {
    "select": [
      {
        "aggFn": "count",
        "valueExpression": ""
      }
    ],
    "where": "ServiceName:api",
    "whereLanguage": "lucene",
    "dateRange": {
      "fromMinutesAgo": 60,
      "toMinutesAgo": 0
    }
  },
  "features": [
    "app-trace",
    "app-search",
    "app-service-map"
  ]
}
