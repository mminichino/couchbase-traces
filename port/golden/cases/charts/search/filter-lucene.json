{
  "id": "search-filter-lucene",
  "description": "Lucene filter chip",
  "source": "logs",
  "config": {
    "select": [
      {
        "aggFn": "count",
        "valueExpression": ""
      }
    ],
    "filters": [
      {
        "type": "lucene",
        "condition": "SeverityText:\"WARN\""
      }
    ],
    "dateRange": {
      "fromMinutesAgo": 60,
      "toMinutesAgo": 0
    }
  },
  "features": [
    "app-search",
    "app-chart"
  ]
}
