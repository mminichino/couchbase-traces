{
  "id": "sessions-replay-ordered",
  "description": "replay events for one session ordered by Timestamp",
  "source": "sessions",
  "config": {
    "select": [
      {
        "valueExpression": "Timestamp",
        "alias": "timestamp"
      },
      {
        "valueExpression": "Body",
        "alias": "b"
      },
      {
        "valueExpression": "ServiceName",
        "alias": "serviceName"
      }
    ],
    "where": "ServiceName:\"browser\"",
    "whereLanguage": "lucene",
    "orderBy": "Timestamp ASC",
    "limit": {
      "limit": 20
    },
    "dateRange": {
      "fromMinutesAgo": 60,
      "toMinutesAgo": 0
    }
  },
  "compare": {
    "ordered": true,
    "ignoreColumns": [
      "__cbt_id"
    ]
  },
  "features": [
    "app-sessions"
  ]
}
