[
  {
    "id": "log-search",
    "route": "/search",
    "assert": {
      "kind": "min_rows",
      "selector": "[data-testid=\"search-results-table\"] tbody tr",
      "min": 50
    }
  },
  {
    "id": "trace-search",
    "route": "/search?source=Traces",
    "setup": [
      {
        "action": "click",
        "selector": "[data-testid=\"source-selector\"]"
      }
    ],
    "assert": {
      "kind": "min_rows",
      "selector": "[data-testid=\"search-results-table\"] tbody tr",
      "min": 50
    }
  },
  {
    "id": "log-histogram",
    "route": "/search",
    "assert": {
      "kind": "chart_has_series",
      "selector": ".recharts-line, .recharts-bar, .recharts-area, svg.recharts-surface path",
      "min": 1
    }
  },
  {
    "id": "chart-explorer-count-by-service",
    "route": "/chart",
    "assert": {
      "kind": "chart_has_series",
      "selector": ".recharts-line, .recharts-bar, .recharts-area, .recharts-cartesian-axis, [data-testid=\"chart-series\"]",
      "min": 3
    },
    "setup": [
      {
        "action": "fill",
        "selector": "[data-testid=\"time-picker-input\"], input[placeholder*=\"Search\"]",
        "value": ""
      }
    ]
  },
  {
    "id": "dashboard-template",
    "route": "/dashboards",
    "assert": {
      "kind": "element_count",
      "selector": "[data-testid^=\"dashboard-tile-\"]",
      "min": 1
    }
  },
  {
    "id": "trace-waterfall",
    "route": "/trace/00000000000000000000000000000001",
    "assert": {
      "kind": "text_present",
      "selector": "body",
      "text": "trace"
    }
  },
  {
    "id": "service-map",
    "route": "/service-map",
    "assert": {
      "kind": "text_present",
      "text": "Sampling",
      "selector": "body"
    }
  },
  {
    "id": "metrics-chart",
    "route": "/chart",
    "assert": {
      "kind": "chart_has_series",
      "selector": ".recharts-line, .recharts-area, [data-testid=\"chart-series\"]",
      "min": 1
    }
  },
  {
    "id": "sessions-list",
    "route": "/sessions",
    "assert": {
      "kind": "text_present",
      "selector": "body",
      "text": "session"
    }
  },
  {
    "id": "session-replay",
    "route": "/sessions",
    "assert": {
      "kind": "text_present",
      "selector": "body",
      "text": "session"
    }
  },
  {
    "id": "kubernetes-dashboard",
    "route": "/kubernetes",
    "assert": {
      "kind": "element_count",
      "selector": "[data-testid^=\"dashboard-tile-\"], [data-testid=\"dashboard-tile\"], .recharts-surface, table tbody tr",
      "min": 1
    }
  },
  {
    "id": "services-dashboard",
    "route": "/services",
    "assert": {
      "kind": "element_count",
      "selector": "[role=\"tab\"], .recharts-surface, table tbody tr, [data-testid^=\"dashboard-tile-\"]",
      "min": 1
    }
  },
  {
    "id": "event-patterns",
    "route": "/search",
    "setup": [
      {
        "action": "click",
        "selector": "text=Event Patterns"
      }
    ],
    "assert": {
      "kind": "element_count",
      "selector": "table tbody tr, [data-testid=\"event-pattern-row\"], [data-testid=\"pattern-row\"]",
      "min": 1
    }
  },
  {
    "id": "event-deltas",
    "route": "/search",
    "assert": {
      "kind": "text_present",
      "selector": "body",
      "text": "Results Table"
    }
  },
  {
    "id": "alerts-list",
    "route": "/alerts",
    "assert": {
      "kind": "text_present",
      "selector": "body",
      "text": "Alert"
    }
  },
  {
    "id": "couchbase-cluster",
    "route": "/cluster",
    "assert": {
      "kind": "text_present",
      "selector": "body",
      "text": "Queries"
    }
  }
]
