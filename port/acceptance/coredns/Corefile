# Alias Slack / incident.io hostnames to the webhook receiver so G1 can
# satisfy Slack URL validation while delivering payloads locally. Everything
# else still forwards to Docker embedded DNS (127.0.0.11).
hooks.slack.com:53 {
  log {
    class all
  }
  errors
  hosts {
    172.28.0.54 hooks.slack.com
    fallthrough
  }
  forward . 127.0.0.11
}

api.incident.io:53 {
  log {
    class all
  }
  errors
  hosts {
    172.28.0.54 api.incident.io
    fallthrough
  }
  forward . 127.0.0.11
}

. {
  log {
    class all
  }
  errors
  forward . 127.0.0.11 {
    max_concurrent 1000
  }
  cache 30
  loop
  reload
  loadbalance
}
