{
  "id": "search-event-deltas-sample",
  "description": "Event deltas background sample",
  "source": "logs",
  "config": {
    "displayType": "search",
    "select": "Body, ServiceName",
    "dateRange": { "fromMinutesAgo": 60, "toMinutesAgo": 0 },
    "orderBy": [{ "valueExpression": "rand()", "ordering": "DESC" }],
    "limit": { "limit": 200 }
  },
  "compare": {
    "ignoreColumns": ["__cbt_id"]
  }
}
