{
  "id": "search-rows-default",
  "description": "Search table default select",
  "source": "logs",
  "config": {
    "displayType": "search",
    "select": "Timestamp, ServiceName, SeverityText, Body",
    "dateRange": { "fromMinutesAgo": 60, "toMinutesAgo": 0 },
    "limit": { "limit": 50 },
    "orderBy": [{ "valueExpression": "Body", "ordering": "ASC" }]
  },
  "compare": {
    "ordered": true,
    "ignoreColumns": ["__cbt_id", "Timestamp"]
  }
}
