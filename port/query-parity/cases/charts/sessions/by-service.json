{
  "id": "sessions-by-service",
  "description": "session events grouped by ServiceName with min/max timestamps",
  "source": "sessions",
  "config": {
    "select": [
      { "valueExpression": "ServiceName", "alias": "serviceName" },
      { "aggFn": "count", "valueExpression": "", "alias": "eventCount" },
      { "valueExpression": "MAX(Timestamp)", "alias": "maxTimestamp" },
      { "valueExpression": "MIN(Timestamp)", "alias": "minTimestamp" }
    ],
    "groupBy": [{ "valueExpression": "ServiceName" }],
    "selectGroupBy": false,
    "orderBy": "eventCount DESC",
    "dateRange": { "fromMinutesAgo": 60, "toMinutesAgo": 0 }
  },
  "compare": {
    "ordered": true,
    "ignoreColumns": ["__cbt_id"]
  }
}
