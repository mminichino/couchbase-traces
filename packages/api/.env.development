# Ports come from scripts/dev-env.sh (worktree isolation) or root .env (defaults)
CBT_LOG_LEVEL=debug
# Development only: keep sessions valid across nodemon restarts.
EXPRESS_SESSION_SECRET="local-development-only"
FRONTEND_URL="http://localhost:${CBT_APP_PORT}"
# Self-telemetry request and response capture. Booleans must be `true`.
CLICKSTACK_CAPTURE_HTTP_BODY=true
OTEL_INSTRUMENTATION_HTTP_CAPTURE_HEADERS_SERVER_REQUEST="user-agent,content-type,x-request-id,referer"
OTEL_INSTRUMENTATION_HTTP_CAPTURE_HEADERS_SERVER_RESPONSE="content-type,content-length"
MONGO_URI="mongodb://localhost:${CBT_DEV_MONGO_PORT}/hyperdx"
NODE_ENV=development
OTEL_SERVICE_NAME="hdx-oss-dev-api"
OTEL_RESOURCE_ATTRIBUTES="service.version=dev"
OTEL_EXPORTER_OTLP_ENDPOINT="http://localhost:${CBT_DEV_OTEL_HTTP_PORT}"
# Per-signal OTLP endpoints (override the base endpoint for individual signals)
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
# OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=
# OTEL_EXPORTER_OTLP_LOGS_ENDPOINT=
PORT=${CBT_API_PORT}
OPAMP_PORT=${CBT_OPAMP_PORT}
REDIS_URL=redis://localhost:6379
USAGE_STATS_ENABLED=false
NODE_OPTIONS="--max-http-header-size=131072"
ENABLE_SWAGGER=true
# Host SDK uses network=external + alternate addresses set by docker/couchbase/init.sh.
DEFAULT_CONNECTIONS=[{"name":"Local Couchbase","kind":"couchbase","host":"couchbase://127.0.0.1:${CBT_DEV_CB_KV_PORT}?network=external","username":"cbt_query","password":"dev-query-password","monitorUsername":"cbt_monitor","monitorPassword":"dev-monitor-password"}]
CBT_DEFAULT_SOURCES_PRESET=couchbase
CBT_COUCHBASE_INGEST_ENABLED=true
CBT_CLICKHOUSE_EXPORT_ENABLED=false
CBT_INGEST_ENDPOINT=http://127.0.0.1:${CBT_DEV_INGEST_PORT}
CBT_INGEST_TOKEN=dev-ingest-token-0000000000000000000000
CBT_COUCHBASE_BUCKET=otel
CBT_COUCHBASE_SCOPE=default

INGESTION_API_KEY="super-secure-ingestion-api-key"
CBT_API_KEY=$INGESTION_API_KEY
ANTHROPIC_API_KEY="your-anthropic-api-key-here"
CBT_COUCHBASE_DEFAULT_TIMEOUT_MS=60000
CBT_COUCHBASE_MAX_TIMEOUT_MS=600000
CBT_COUCHBASE_CONNECT_TIMEOUT_MS=10000
CBT_COUCHBASE_CLUSTER_IDLE_MS=600000
CBT_COUCHBASE_MAX_CLUSTERS=50
CBT_COUCHBASE_MAX_BUFFERED_BYTES=268435456
CBT_COUCHBASE_FRAME_ROWS=500
