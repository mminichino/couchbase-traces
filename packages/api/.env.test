# Environment configuration for Integration tests, corresponding to ports defined in docker-compose.ci.yml
# For multi-agent worktree support, ports are configured via CBT_CI_* env vars.
# Set CBT_CI_API_PORT, CBT_CI_OPAMP_PORT, CBT_CI_CB_* before
# running tests to use non-default ports (see Makefile dev-int target).
RUN_SCHEDULED_TASKS_EXTERNALLY=true
FRONTEND_URL=http://app:8080
NODE_ENV=test
PORT=${CBT_CI_API_PORT:-19000}
OPAMP_PORT=${CBT_CI_OPAMP_PORT:-14320}
# Couchbase on the host (published from docker-compose.ci.yml) for FixtureDataClient.
# Do NOT set CBT_TEST_COUCHBASE_* here: those drive port/couchbase-test (cbt-query-
# password + `test` bucket). Overriding them to CI-compose creds makes the
# dedicated Couchbase integration job AUTHENTICATION_FAILED, and makes
# *.couchbase.int.test.ts connect to the shard stack then fail on missing
# `test` instead of skipping.
CBT_COUCHBASE_CONNSTR=couchbase://127.0.0.1
CBT_COUCHBASE_BUCKET=otel
CBT_COUCHBASE_SCOPE=default
CBT_COUCHBASE_ADMIN_USER=Administrator
CBT_COUCHBASE_ADMIN_PASSWORD=dev-admin-password
CBT_COUCHBASE_QUERY_USER=cbt_query
CBT_COUCHBASE_QUERY_PASSWORD=dev-query-password
# App metadata bucket from docker-compose.ci.yml couchbase-init (plan C0).
CBT_METADATA_USER=cbt_meta
CBT_METADATA_PASSWORD=dev-metadata-password
CBT_CI_CB_QUERY_PORT=${CBT_CI_CB_QUERY_PORT:-8093}
# Compat aliases: many int tests still create Connection docs via
# config.CLICKHOUSE_* (pre-port names). Point them at the CI compose cluster
# so DataClient queries authenticate instead of AUTHENTICATION_FAILED on
# undefined password / host.
CLICKHOUSE_HOST=couchbase://127.0.0.1
CLICKHOUSE_USER=cbt_query
CLICKHOUSE_PASSWORD=dev-query-password
# Default to only logging errors. Adjust if you need more verbosity.
# Note: the logger module is mocked in jest.setup.ts to suppress expected
# operational noise (validation errors, MCP tool errors, etc.) during tests.
CBT_LOG_LEVEL=error