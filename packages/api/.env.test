# Environment configuration for Integration tests, corresponding to ports defined in docker-compose.ci.yml
# For multi-agent worktree support, ports are configured via CBT_CI_* env vars.
# Set CBT_CI_MONGO_PORT, CBT_CI_API_PORT, CBT_CI_OPAMP_PORT, CBT_CI_CB_* before
# running tests to use non-default ports (see Makefile dev-int target).
RUN_SCHEDULED_TASKS_EXTERNALLY=true
FRONTEND_URL=http://app:8080
MONGO_URI=mongodb://localhost:${CBT_CI_MONGO_PORT:-39999}/hyperdx-test
NODE_ENV=test
PORT=${CBT_CI_API_PORT:-19000}
OPAMP_PORT=${CBT_CI_OPAMP_PORT:-14320}
# Couchbase on the host (published from docker-compose.ci.yml).
CBT_COUCHBASE_CONNSTR=couchbase://127.0.0.1
CBT_COUCHBASE_BUCKET=otel
CBT_COUCHBASE_SCOPE=default
CBT_COUCHBASE_ADMIN_USER=Administrator
CBT_COUCHBASE_ADMIN_PASSWORD=dev-admin-password
CBT_COUCHBASE_QUERY_USER=cbt_query
CBT_COUCHBASE_QUERY_PASSWORD=dev-query-password
CBT_CI_CB_QUERY_PORT=${CBT_CI_CB_QUERY_PORT:-8093}
CBT_TEST_COUCHBASE_CONNSTR=couchbase://127.0.0.1
CBT_TEST_COUCHBASE_ADMIN_USER=Administrator
CBT_TEST_COUCHBASE_ADMIN_PASSWORD=dev-admin-password
CBT_TEST_COUCHBASE_USER=cbt_query
CBT_TEST_COUCHBASE_PASSWORD=dev-query-password
# Default to only logging errors. Adjust if you need more verbosity.
# Note: the logger module is mocked in jest.setup.ts to suppress expected
# operational noise (validation errors, MCP tool errors, etc.) during tests.
CBT_LOG_LEVEL=error