# Environment configuration for E2E tests
# Ports are configured via CBT_E2E_* env vars (see scripts/slots.sh and scripts/test-e2e.sh).

RUN_SCHEDULED_TASKS_EXTERNALLY=true
FRONTEND_URL=http://localhost:${CBT_E2E_APP_PORT:-21300}
# MongoDB connection string
MONGO_URI=mongodb://localhost:${CBT_E2E_MONGO_PORT:-21100}/hyperdx-e2e
NODE_ENV=test
PORT=${CBT_E2E_API_PORT:-21000}
OPAMP_PORT=${CBT_E2E_OPAMP_PORT:-20320}

# DEFAULT_CONNECTIONS and DEFAULT_SOURCES are injected from packages/app/tests/e2e/fixtures/e2e-fixtures.json
# by the e2e API runner (run-e2e.js) and by base-test for local mode.

# Disable usage stats for e2e tests
USAGE_STATS_ENABLED=false