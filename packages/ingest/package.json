{
  "name": "@couchbase-traces/ingest",
  "description": "Couchbase Traces telemetry ingestion service",
  "version": "1.0.0",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=22.16.0"
  },
  "dependencies": {
    "@couchbase-traces/common-utils": "workspace:*",
    "couchbase": "4.7.2"
  },
  "devDependencies": {
    "@couchbase-traces/common-utils": "workspace:*",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.15.18",
    "eslint": "^9.39.1",
    "jest": "^30.2.0",
    "ts-jest": "^29.4.11",
    "tsc-alias": "^1.8.8",
    "tsx": "^4.20.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.46.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "setup": "node dist/setup/cli.js",
    "sample-data": "tsx src/sample/cli.ts",
    "docs": "tsx src/setup/docs.ts",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "ci:lint": "yarn lint && tsc -p tsconfig.json --noEmit",
    "ci:unit": "jest --ci --coverage"
  }
}
