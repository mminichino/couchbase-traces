{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "scripts/__tests__/*.test.mjs"
      ]
    },
    "packages/app": {
      "entry": [
        "pages/**/*.{ts,tsx}",
        "scripts/*.js",
        "tests/e2e/**/*.ts"
      ],
      "project": [
        "src/**/*.{ts,tsx}",
        "pages/**/*.{ts,tsx}"
      ],
      "ignore": [
        ".storybook/public/**"
      ],
      "ignoreDependencies": [
        "eslint-config-next",
        "@chromatic-com/storybook",
        "@storybook/addon-themes",
        "react-is"
      ]
    },
    "packages/api": {
      "entry": [
        "src/index.ts",
        "src/tasks/index.ts",
        "src/serverless.ts",
        "scripts/*.ts",
        "src/fixtures.ts"
      ],
      "project": [
        "src/**/*.ts"
      ],
      "ignoreDependencies": [
        "pino-pretty",
        "aws4"
      ],
      "ignore": [
        "src/opamp/**",
        "src/utils/logParser.ts"
      ]
    },
    "packages/common-utils": {
      "entry": [
        "src/**/*.ts",
        "!src/__tests__/**",
        "!src/**/*.test.*"
      ],
      "project": [
        "src/**/*.ts"
      ],
      "ignoreDependencies": [
        "@stryker-mutator/core"
      ],
      "ignoreBinaries": [
        "stryker"
      ]
    },
    "packages/cli": {
      "ignoreBinaries": [
        "claude"
      ]
    },
    "packages/ingest": {
      "entry": [
        "src/index.ts",
        "src/setup/cli.ts",
        "src/setup/docs.ts"
      ],
      "project": [
        "src/**/*.ts"
      ],
      "ignoreDependencies": [
        "@couchbase-traces/common-utils"
      ]
    },
    "packages/hdx-eval": {
      "project": [
        "src/**/*.ts"
      ],
      "ignoreDependencies": [
        "tsx"
      ],
      "ignoreBinaries": [
        "claude"
      ]
    }
  },
  "ignore": [
    "scripts/dev-portal/**",
    ".github/scripts/**",
    ".github/actions/**",
    "docker/hyperdx/**",
    ".claude/**",
    "port/**",
    "packages/api/src/controllers/aiSummarize.ts",
    "packages/api/src/middleware/validation.ts",
    "packages/api/src/utils/apiDataClient.ts"
  ],
  "ignoreBinaries": [
    "make",
    "migrate",
    "stryker"
  ],
  "ignoreDependencies": [
    "@dotenvx/dotenvx",
    "concurrently",
    "dotenv",
    "babel-plugin-react-compiler",
    "@stryker-mutator/core",
    "jscpd",
    "@braintree/sanitize-url",
    "@opentelemetry/api-logs",
    "@opentelemetry/otlp-transformer",
    "@opentelemetry/resources",
    "@opentelemetry/sdk-logs",
    "couchbase",
    "http-proxy-middleware",
    "rimraf",
    "serve"
  ],
  "include": [
    "nsExports"
  ],
  "exclude": [
    "exports",
    "types",
    "enumMembers",
    "duplicates",
    "nsExports"
  ]
}
